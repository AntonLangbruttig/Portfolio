# AWS Credentials for SES (Simple Email Service)
# Get these from AWS IAM Console
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Email Configuration
SES_SENDER_EMAIL=your_sender_email@example.com
SES_RECIPIENT_EMAIL=your_recipient_email@example.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yourdomain.com